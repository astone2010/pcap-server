{
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "$CLAUDE_PROJECT_DIR/.claude/hooks/session-start.sh"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "if": "Bash(git *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-preflight.sh",
            "timeout": 15,
            "statusMessage": "Checking dev-skills gates..."
          },
          {
            "type": "command",
            "if": "Bash(gh *)",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-preflight.sh",
            "timeout": 15,
            "statusMessage": "Checking dev-skills gates..."
          }
        ]
      },
      {
        "matcher": "mcp__github__(create_pull_request|merge_pull_request|push_files|create_or_update_file|delete_file)",
        "hooks": [
          {
            "type": "command",
            "command": "${CLAUDE_PROJECT_DIR}/.claude/hooks/gate-preflight.sh",
            "timeout": 15,
            "statusMessage": "Checking dev-skills gates..."
          }
        ]
      }
    ]
  }
}
