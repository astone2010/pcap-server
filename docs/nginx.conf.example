# pcap-server behind nginx.
#
# Two settings here are not optional and not obvious. Both are called out below.

# Redirect plain HTTP. Over HTTP pcap-server is read-only: captures cannot be
# downloaded, SSH keys cannot be uploaded, and nothing can be changed.
server {
    listen 80;
    listen [::]:80;
    server_name pcap.example.com;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name pcap.example.com;

    ssl_certificate     /etc/letsencrypt/live/pcap.example.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/pcap.example.com/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_session_cache   shared:SSL:10m;
    ssl_stapling on;
    ssl_stapling_verify on;

    # A capture download is the whole pcap. 0 means no limit; set a real ceiling
    # if you prefer. (Uploads are only SSH keys, which the app caps at 64 KB.)
    client_max_body_size 0;

    location / {
        proxy_pass http://127.0.0.1:8080;
        proxy_http_version 1.1;

        proxy_set_header Host              $host;
        proxy_set_header X-Real-IP         $remote_addr;

        # ------------------------------------------------------------------
        # REQUIRED. Without this pcap-server cannot tell that TLS terminated
        # here, and stays in read-only mode: no downloads, no key uploads, no
        # configuration changes. Set TRUST_PROXY_HEADERS=true on the app to
        # make it trust this header.
        proxy_set_header X-Forwarded-Proto $scheme;
        # ------------------------------------------------------------------

        # $remote_addr, NOT $proxy_add_x_forwarded_for. The latter appends the
        # real peer to whatever the client sent, leaving attacker-controlled
        # text in the header. pcap-server keys its login rate limiter on this,
        # and reads the rightmost entry for that reason -- but sending only the
        # address nginx actually saw removes the ambiguity entirely.
        proxy_set_header X-Forwarded-For   $remote_addr;

        # ------------------------------------------------------------------
        # REQUIRED for capture downloads to stay private.
        #
        # With buffering on, nginx spools the response body to disk under
        # proxy_temp_path when it exceeds the in-memory buffers. A capture
        # download is decrypted plaintext, so buffering writes an unencrypted
        # copy of the pcap onto the proxy's filesystem -- undoing the point of
        # encrypting captures at rest. Off, it streams straight through.
        proxy_buffering off;
        proxy_request_buffering off;
        # ------------------------------------------------------------------

        # A large capture can take a while to stream.
        proxy_read_timeout 600s;
        proxy_send_timeout 600s;

        # pcap-server sets its own CSP, HSTS and frame headers. Adding them here
        # too would duplicate them; add_header in nginx does not replace an
        # upstream header, it appends a second one.
        proxy_hide_header X-Powered-By;

        # No value in compressing a pcap, and it is already high entropy.
        gzip off;
    }
}
